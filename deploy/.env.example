# Copy to deploy/.env on the production server. Never commit deploy/.env.

# PostgreSQL: keep DB_PASSWORD and POSTGRES_PASSWORD identical.
POSTGRES_DB=isezerano_db
POSTGRES_USER=isezerano
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_NAME=isezerano_db
DB_USER=isezerano
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Django
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_DJANGO_SECRET
DEBUG=False
ALLOWED_HOSTS=prod.isezerano.com,161.35.113.160,localhost
CORS_ALLOWED_ORIGINS=https://prod.isezerano.com
CSRF_TRUSTED_ORIGINS=https://prod.isezerano.com
SECURE_SSL_REDIRECT=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Public frontend origin. Do not append /api.
NEXT_PUBLIC_API_URL=https://prod.isezerano.com

# Cloudinary. Leave all three blank to use the persistent local media volume.
# The API key must have create/upload permission.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@isezerano.com
ADS_INQUIRY_EMAIL=ads@isezerano.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
