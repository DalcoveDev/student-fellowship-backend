# =============================================================================
# Isezerano Backend — Environment Variables Configuration
# =============================================================================

# Django Settings Module (use config.settings.prod for production)
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ENV=production

# Core Security: Generate via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=isezerano.com,prod.isezerano.com,www.isezerano.com,localhost,127.0.0.1

# Obfuscated Admin Path (do not use default 'admin/')
ADMIN_URL=isezerano-mgmt-portal/

# Database Connection (PostgreSQL)
DB_NAME=pulse_db
DB_USER=isezerano_user
DB_PASSWORD=replace-with-secure-postgres-password
DB_HOST=db
DB_PORT=5432
# Alternatively supply a complete URL:
# DATABASE_URL=postgresql://isezerano_user:password@db:5432/pulse_db

# Redis Caching & Celery Broker
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0

# CORS & CSRF Trusted Origins (comma-separated URLs)
# Include the website origin that calls this API (local dev: http://localhost:3000).
CORS_ALLOWED_ORIGINS=https://isezerano.com,https://www.isezerano.com,https://prod.isezerano.com,https://christianstudentsnetwork.org,https://www.christianstudentsnetwork.org
CSRF_TRUSTED_ORIGINS=https://isezerano.com,https://www.isezerano.com,https://prod.isezerano.com,https://christianstudentsnetwork.org,https://www.christianstudentsnetwork.org

# Media & Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outbound Email (Mailjet API & SMTP)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=notification@isezerano.com
SERVER_EMAIL=notification@isezerano.com
ADS_INQUIRY_EMAIL=notification@isezerano.com

# Error Monitoring (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.1

# Production Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
