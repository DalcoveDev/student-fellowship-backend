# =============================================================================
# Isezerano Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Django Core ---
SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key-print(get_random_secret_key())
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_NAME=isezerano_db
DB_USER=postgres
DB_PASSWORD=CHANGE-ME
DB_HOST=127.0.0.1
DB_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/dbname  # Alternative (overrides above)

# --- Redis (Caching & Celery Broker) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Cloudinary Media Storage (optional — falls back to local filesystem) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP Email ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@isezerano.com
ADS_INQUIRY_EMAIL=ads@isezerano.com
EMAIL_USE_TLS=True

# --- Production SSL ---
SECURE_SSL_REDIRECT=False
